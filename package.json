{
  "name": "beacon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && npm run app:build && next build",
    "start": "node init && next start",
    "lint": "next lint",
    "setup": "npm --prefix ionic install && node scripts/setup-env.mjs && prisma db push && node prisma/seed.mjs",
    "db:reset": "prisma db push && node prisma/seed.mjs",
    "test:e2e": "npm run db:reset && node --env-file=.env scripts/e2e.mjs; npm run db:reset",
    "app:dev": "npm --prefix ionic run dev",
    "app:build": "npm --prefix ionic run build",
    "postinstall": "prisma generate",
    "vercel-build": "prisma db push --skip-generate && npm --prefix ionic ci --include=dev && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@prisma/client": "6.16.2",
    "lucide-react": "^0.544.0",
    "next": "15.5.9",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.55.0",
    "prisma": "6.16.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5"
  }
}
