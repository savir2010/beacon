# Postgres. Locally: postgresql://localhost:5432/beacon. On Vercel: the Neon/Postgres connection string.
DATABASE_URL="postgresql://localhost:5432/beacon"
# 32 random bytes, base64. Encrypts every stored document (AES-256-GCM). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BEACON_FILE_KEY=""
# Public base URL used in emailed links. On Vercel it falls back to the production domain if unset.
BEACON_APP_URL="http://localhost:3000"
